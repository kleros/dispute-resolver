{
  "name": "@dispute-resolver/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e": "playwright test --project=chromium",
    "e2e:runner": "playwright test e2e/runner --project=chromium --project=runner-firefox --project=runner-webkit",
    "e2e:scroller": "xvfb-run -a playwright test --project=scroller-firefox --project=scroller-webkit --workers=1",
    "format": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@dispute-resolver/core": "workspace:^",
    "@fontsource/open-sans": "^5",
    "@internationalized/date": "^3.7.0",
    "@kleros/kleros-app": "3.1.0",
    "@kleros/ui-components-library": "3.10.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@wagmi/core": "^2.22.1",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "^18.3.1",
    "react-markdown": "9.1.0",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "viem": "^2.57.6",
    "wagmi": "^2.19.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@reown/appkit-controllers": "1.8.24",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.2",
    "parse5": "^8.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
