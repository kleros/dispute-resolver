# Copy to .env at the repository root and fill in the values. Only REACT_APP_* names reach the app.
# The values are built into the public bundle, but RPC URLs carry API keys: never commit .env.

# Reown (WalletConnect) project ID. Empty: the app boots read-only and no wallet can connect.
REACT_APP_WALLETCONNECT_PROJECT_ID=

# Atlas endpoint for sign-in and IPFS uploads (https:). Empty: uploads are unavailable.
REACT_APP_ATLAS_URI=

# Meta-evidence locator API.
REACT_APP_METAEVIDENCE_URL=

# IPFS gateway origin (a bare https: origin). Empty: https://cdn.kleros.link.
REACT_APP_IPFS_GATEWAY=

# Read RPCs, one per chain.
REACT_APP_WEB3_PROVIDER_URL=
REACT_APP_WEB3_XDAI_PROVIDER_URL=
REACT_APP_WEB3_CHIADO_PROVIDER_URL=
REACT_APP_WEB3_SEPOLIA_PROVIDER_URL=
REACT_APP_UNICHAIN=
REACT_APP_UNICHAIN_SEPOLIA=
REACT_APP_WEB3_POLYGON_PROVIDER_URL=
REACT_APP_ARBITRUM_ONE=
REACT_APP_ARBITRUM_SEPOLIA=
REACT_APP_OPTIMISM_SEPOLIA=
REACT_APP_BASE=
REACT_APP_BASE_SEPOLIA=
