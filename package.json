{
  "name": "dispute-resolver",
  "private": true,
  "version": "1.0.0",
  "author": "Ferit <ferit@cryptolab.net> (https://github.com/0xferit)",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "yarn workspaces foreach --all --parallel --include '@dispute-resolver/*' run typecheck",
    "lint": "yarn workspaces foreach --all --parallel --include '@dispute-resolver/*' run lint && eslint eslint.config.mjs",
    "test": "yarn workspaces foreach --all --parallel --include '@dispute-resolver/*' run test",
    "build": "yarn workspaces foreach --all --topological --include '@dispute-resolver/*' run build",
    "check:bundle": "yarn workspace @dispute-resolver/web check:bundle",
    "rpc:preflight": "yarn workspace @dispute-resolver/core rpc:preflight",
    "format": "yarn workspaces foreach --all --parallel --include '@dispute-resolver/*' run format && prettier --write eslint.config.mjs tsconfig.base.json package.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "resolutions": {
    "@wagmi/connectors@>=5.9.9": "6.2.0",
    "eslint-plugin-sonarjs/typescript": "~5.9.3",
    "ws@npm:8.18.0": "8.21.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 180
  },
  "volta": {
    "node": "22.23.4",
    "yarn": "4.9.2"
  }
}
